# ─────────────────────────────────────────────────────────────────────────────
# CleverTap Integration Environment Variables (Prepared for future connection)
# ─────────────────────────────────────────────────────────────────────────────

# Frontend Web SDK Configuration:
NEXT_PUBLIC_CLEVERTAP_ACCOUNT_ID=YOUR_CLEVERTAP_ACCOUNT_ID
NEXT_PUBLIC_CLEVERTAP_REGION=in1 # Supported: in1, eu1, us1, sg1

# Backend Server API Configuration:
CLEVERTAP_ACCOUNT_ID=YOUR_CLEVERTAP_ACCOUNT_ID
CLEVERTAP_PASSCODE=YOUR_CLEVERTAP_PASSCODE # API Secret / Passcode from Settings > Project
CLEVERTAP_REGION=in1

