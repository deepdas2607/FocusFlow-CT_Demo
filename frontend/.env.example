# Frontend environment variables
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to git

# Backend API URL - where your Express server is running
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── CleverTap Configuration ────────────────────────────────────────────────
# Get these values from CleverTap Dashboard > Settings > Project Settings
#
# Account ID: Found under "Project ID" in your CleverTap account settings
NEXT_PUBLIC_CLEVERTAP_ACCOUNT_ID="YOUR_CLEVERTAP_ACCOUNT_ID"

# Region code: Determines which CleverTap data center to use
# Common values:
#   in1  - India (Mumbai)
#   eu1  - Europe (Amsterdam)
#   sg1  - Singapore
#   us1  - United States
#   sk1  - Skip (no region, uses default)
# Leave empty if you are unsure - CleverTap will use your account's default region
NEXT_PUBLIC_CLEVERTAP_REGION="in1"

